{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${LAYA_CONTEXT_ROUTER_CLI}\" hook --hook UserPromptSubmit --repository-root \"${CLAUDE_PROJECT_DIR}\" --real"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${LAYA_CONTEXT_ROUTER_CLI}\" hook --hook PostCompact --log-state",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
